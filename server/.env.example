# إعدادات الـ API المستقل — كل القيم من متغيرات البيئة فقط
NODE_ENV=production
PORT=8787

# PostgreSQL على سيرفرنا الخاص
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fekrahedu
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# المصادقة (JWT صادر من هذا السيرفر)
JWT_SECRET=
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# النطاقات المسموح لها بالاتصال
CORS_ORIGINS=https://www.fekrahedu.com,https://fekrahedu.com

# التخزين (ملفات العقود والفواتير والمرفقات)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/lib/fekrahedu/storage
STORAGE_PUBLIC_BASE_URL=https://api.fekrahedu.com/storage
